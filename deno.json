{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "exclude": ["lib/parser/wasm/"]
  "lint": {
    "files": {
      "include": ["lib/"],
    },
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "files": {
      "include": ["lib/"],
    },
    "options": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "unstable": ["sloppy-imports"],
  "imports": {
    "@babel/types": "npm:@babel/types@^7.28.5",
    "@babel/generator": "npm:@babel/generator@^7.28.5",
    "@babel/traverse": "npm:@babel/traverse@^7.28.5",
    "@types/babel__generator": "npm:@types/babel__generator@^7.27.0",
    "@types/babel__traverse": "npm:@types/babel__traverse@^7.28.0",
    "kaitai-struct": "npm:kaitai-struct@^0.11.0",
    "module": "node:module",
    "url": "node:url"
  }
}
